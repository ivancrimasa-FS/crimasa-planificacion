rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Planificación de personal (esta app) ----
    // Opción A (la que uso por defecto): cualquiera con la URL puede leer y escribir.
    // Sirve para una herramienta interna, pero NO es seguridad real.
    match /plan_catalogo/{documento} {
      allow read, write: if true;
    }
    match /plan_dias/{dia} {
      allow read, write: if true;
    }

    // ---- Opción B: exigir usuario autenticado ----
    // Activa el proveedor "Anónimo" en Firebase → Authentication → Sign-in method
    // y sustituye las dos reglas de arriba por estas:
    //
    // match /plan_catalogo/{documento} {
    //   allow read, write: if request.auth != null;
    // }
    // match /plan_dias/{dia} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
