rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Planificación de personal.
    // Solo pueden leer y escribir los usuarios con cuenta creada en
    // Firebase → Authentication (correo y contraseña).
    // No hay registro público: las cuentas las creas tú a mano.

    function autenticado() {
      return request.auth != null;
    }

    match /plan_catalogo/{documento} {
      allow read, write: if autenticado();
    }

    match /plan_dias/{dia} {
      allow read, write: if autenticado();
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
